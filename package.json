{
  "name": "vite-plugin-size-budget",
  "version": "0.2.0",
  "description": "Fail Vite builds that exceed gzip/brotli size budgets, with diffs against a baseline and a GitHub Actions summary",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "bundle-size",
    "performance-budget",
    "lighthouse",
    "performance",
    "ci",
    "github-actions"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "picomatch": "^4.0.2"
  },
  "bin": {
    "size-budget": "./bin/size-budget.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yaon1/vite-plugin-size-budget.git"
  },
  "bugs": {
    "url": "https://github.com/yaon1/vite-plugin-size-budget/issues"
  },
  "homepage": "https://github.com/yaon1/vite-plugin-size-budget#readme",
  "engines": {
    "node": ">=20"
  }
}
